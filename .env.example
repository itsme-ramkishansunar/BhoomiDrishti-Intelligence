# Frontend + backend
FRONTEND_ORIGIN=http://localhost:5173
BACKEND_PORT=8787
BHOOMI_BACKEND_ORIGIN=http://127.0.0.1:8787
NODE_ENV=development

# Local administrator bootstrap for development.
# CHANGE THIS before any shared or production deployment.
BHOOMI_ADMIN_EMAIL=admin@example.invalid
BHOOMI_ADMIN_PASSWORD=

# AI provider: local (default) or gemini/anthropic
AI_PROVIDER=local
AI_MODEL=gemini-3.8-flash

# Keep external AI disabled unless this deployment is explicitly approved to send
# the selected project data to the provider.
AI_DATA_MODE=local_only

# Gemini: server-side only; never put the key in VITE_* variables.
GEMINI_API_KEY=

# Anthropic (optional alternative provider)
ANTHROPIC_API_KEY=

# Display the State Emblem of India only in an authorized government deployment.
VITE_GOVERNMENT_EMBLEM_AUTHORIZED=false

BHOOMI_GOV_EMAIL=government.officer@example.invalid
BHOOMI_GOV_PASSWORD=
BHOOMI_DEPT_EMAIL=department.officer@example.invalid
BHOOMI_DEPT_PASSWORD=
BHOOMI_LEGAL_EMAIL=legal.officer@example.invalid
BHOOMI_LEGAL_PASSWORD=
BHOOMI_VIEWER_EMAIL=viewer@example.invalid
BHOOMI_VIEWER_PASSWORD=

# Persistent application repository.
# Shared is the default so every BHOOMIDHRISHTI release on this machine reuses the same data.
# The default local store is OS-specific (Windows: %LOCALAPPDATA%\BhoomiDrishti\data).
# Set BHOOMI_STORAGE_MODE=isolated only for disposable tests.
BHOOMI_STORAGE_MODE=shared
BHOOMI_DATA_DIR=backend/data
BHOOMI_DB_PATH=backend/data/bhoomidrishti.sqlite
# Optional explicit absolute shared root; normally leave blank.
BHOOMI_PERSISTENT_ROOT=
# Shared mode ignores legacy/release-relative paths. Set true only when you intentionally want a custom absolute store.
BHOOMI_ALLOW_CUSTOM_STORAGE=false

# Optional: point setup:local at an explicit existing .env file on this machine.
# Example PowerShell: $env:BHOOMI_ENV_SOURCE='D:\BHOOMIDHRISHTI_SECRETS\.env'
BHOOMI_ENV_SOURCE=
# Legacy Upgrade 15 discovery is disabled by default; enable only for migration compatibility.
BHOOMI_LEGACY_ENV_DISCOVERY=false

# Optional ordered model fallbacks used only if the primary Gemini model is unavailable.
AI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash

# Local-only role test accounts; keep false in production
BHOOMI_DEMO_ACCESS_ENABLED=false
GEMINI_API_VERSION=v1
AI_THINKING_LEVEL=low
AI_MAX_OUTPUT_TOKENS=1400
AI_PROVIDER_TIMEOUT_MS=5000
AI_PROVIDER_TOTAL_BUDGET_MS=9000
AI_PROVIDER_FAILURE_COOLDOWN_MS=60000

# Speed-first mode: deterministic authorised evidence answers return immediately. Set false to wait for Gemini.
AI_LOCAL_FIRST=true

# Upgrade 40 portability / local deployment
# Production requires explicit administrator credentials; never use development defaults.
SERVE_FRONTEND=false
BACKEND_HOST=0.0.0.0

# U55 missing-only project initialization at startup (set false to disable)
BHOOMI_AUTO_INITIALIZE_ON_STARTUP=true

# Local demo only: allow deterministic district-centroid points for projects with no location. Production must set false.
BHOOMI_LOCAL_DEMO_LOCATION_FALLBACK=false

# Optional public reviewer mode. Explicitly enable only on a deployment that contains
# synthetic/reference records. Visitors receive a Viewer session limited to source_label=synthetic_demo.
# Production requires synthetic_only + AI_DATA_MODE=local_only. Never enable this against authoritative/private data.
BHOOMI_PUBLIC_DEMO_ENABLED=false
BHOOMI_PUBLIC_DEMO_DATA_MODE=synthetic_only

# Reverse proxy awareness. Keep 0 for direct exposure; set 1 when exactly one trusted reverse proxy is in front of the app.
BHOOMI_TRUST_PROXY=0
